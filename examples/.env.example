# Hindsight Environment Configuration
# Copy to .env and fill in your values

# ===========================================
# LLM Configuration (Required)
# ===========================================
# Supported providers: openai, groq, ollama, gemini, anthropic, lmstudio

# OpenAI
HINDSIGHT_API_LLM_PROVIDER=openai
HINDSIGHT_API_LLM_API_KEY=your-api-key-here
HINDSIGHT_API_LLM_MODEL=gpt-4o-mini
HINDSIGHT_API_LLM_BASE_URL=https://api.openai.com/v1

# --- Alternative providers ---
#
# Anthropic Claude:
# HINDSIGHT_API_LLM_PROVIDER=anthropic
# HINDSIGHT_API_LLM_API_KEY=your-anthropic-key
# HINDSIGHT_API_LLM_MODEL=claude-sonnet-4-20250514
#
# Groq (free tier available):
# HINDSIGHT_API_LLM_PROVIDER=groq
# HINDSIGHT_API_LLM_API_KEY=gsk_your_groq_key
# HINDSIGHT_API_LLM_MODEL=llama-3.1-70b-versatile
#
# LM Studio (local):
# HINDSIGHT_API_LLM_PROVIDER=lmstudio
# HINDSIGHT_API_LLM_API_KEY=lmstudio
# HINDSIGHT_API_LLM_BASE_URL=http://localhost:1234/v1
# HINDSIGHT_API_LLM_MODEL=qwen2.5-32b-instruct

# ===========================================
# Performance (Optional)
# ===========================================
HINDSIGHT_API_LLM_MAX_CONCURRENT=8
HINDSIGHT_API_LLM_TIMEOUT=180
